# ─────────────────────────────────────────────────────────────────────────────
# Root
# ─────────────────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.iml
*.ipr
*.iws

# Environment files
.env
.env.*.local

# Logs
logs/
*.log

# ─────────────────────────────────────────────────────────────────────────────
# Frontend: React Native (Expo)
# ─────────────────────────────────────────────────────────────────────────────

# Node modules
/frontend/node_modules/

# Expo
/frontend/.expo/
/frontend/.expo-shared/
/frontend/web-build/

# React Native artifacts
/frontend/android/.gradle/
/frontend/android/app/build/
/frontend/ios/Pods/
/frontend/ios/build/

# NPM/Yarn debug
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*

# ─────────────────────────────────────────────────────────────────────────────
# Backend: Spring Boot (Java + MongoDB)
# ─────────────────────────────────────────────────────────────────────────────

# Maven
/backend/target/
/backend/.mvn/
/backend/mvnw*
/backend/mvnw.cmd

# Gradle (if you switch to Gradle)
/backend/.gradle/
/backend/build/

# Java compiled
*.class
*.jar
*.war
*.ear

# Spring Boot devtools restarts
restart/**

# ─────────────────────────────────────────────────────────────────────────────
# Miscellaneous
# ─────────────────────────────────────────────────────────────────────────────

# Package locks: you DO want to track these for reproducibility—do NOT ignore!
# /frontend/yarn.lock
# /frontend/package-lock.json

# Coverage reports
coverage/
*.lcov

# Testing / temp
/tmp/
